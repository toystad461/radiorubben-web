# Private server configuration, not a working credential file. Mode 0600, root-owned.
# No automatic credential creation or copying from Studio/test WordPress.
RRFR_WP_USER=
RRFR_WP_APP_PASSWORD=
RRFR_OPENAI_KEY=
# Explicit Responses model supporting web_search and json_object. Verify account availability.
RRFR_RESEARCH_MODEL=
RRFR_CONTROL_SECRET=
RRFR_COLLECTION_STATE=/var/lib/rrfr-source-collection
RRFR_COLLECTION_MODE=dry-run
RRFR_CONTROL_PORT=9086

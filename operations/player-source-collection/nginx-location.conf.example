# Include only in the verified existing TLS virtual host on the VPS.
# No new public application, port, hostname or change to Studio PHP isolation.
location = /rrfr-source-collection/v1/status {
    proxy_pass http://127.0.0.1:9086;
    proxy_connect_timeout 2s;
    proxy_read_timeout 3s;
    proxy_set_header Host $host;
    proxy_set_header X-RR-Time $http_x_rr_time;
    proxy_set_header X-RR-Nonce $http_x_rr_nonce;
    proxy_set_header X-RR-Signature $http_x_rr_signature;
    proxy_set_header Authorization "";
    access_log off;
}
location = /rrfr-source-collection/v1/control {
    client_max_body_size 2k;
    proxy_pass http://127.0.0.1:9086;
    proxy_connect_timeout 2s;
    proxy_read_timeout 3s;
    proxy_set_header Host $host;
    proxy_set_header X-RR-Time $http_x_rr_time;
    proxy_set_header X-RR-Nonce $http_x_rr_nonce;
    proxy_set_header X-RR-Signature $http_x_rr_signature;
    proxy_set_header Authorization "";
    access_log off;
}

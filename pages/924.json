ls > div{display:flex;justify-content:space-between;align-items:baseline;gap:8px}\n.rr-dk-test .dk-weather-details span{font-size:11px;color:var(--muted)}\n.rr-dk-test .dk-weather-details strong{font-size:15px;color:white;white-space:nowrap}\n.rr-dk-test .dk-weather-source{font-size:11px;color:var(--muted);line-height:1.5;margin:16px 0 0}\n.rr-dk-test .dk-weather-source a{font-size:11px}\n@media(min-width:1300px){.rr-dk-test .dk-layout{grid-template-columns:240px minmax(0,1fr) 310px;gap:18px}.rr-dk-test .dk-weather{grid-column:1;grid-row:1;position:sticky;top:232px}.rr-dk-test .dk-main{grid-column:2;grid-row:1}.rr-dk-test .dk-rail{grid-column:3;grid-row:1}}\n@media(min-width:1300px){.rr-dk-test .dk-layout:has(.dk-weather[hidden]){grid-template-columns:minmax(0,1fr) 340px}.rr-dk-test .dk-layout:has(.dk-weather[hidden]) .dk-main{grid-column:1}.rr-dk-test .dk-layout:has(.dk-weather[hidden]) .dk-rail{grid-column:2}}\n@media(min-width:1180px) and (max-width:1299px){.rr-dk-test .dk-main{grid-column:1;grid-row:1}.rr-dk-test .dk-weather{grid-column:1;grid-row:2}.rr-dk-test .dk-rail{grid-column:2;grid-row:1 / span 2}}\n</style>\n<div class=\"rr-dk-test\" id=\"rr-dk-test\">\n<header class=\"dk-top\"><div><p class=\"dk-label\">Radio Rubben · Fotball</p><h1>Dagens kamp</h1></div><span class=\"dk-test-tag\">Testside</span></header>\n<div class=\"dk-layout\"><aside class=\"dk-weather\" id=\"dk-weather\" aria-label=\"Vær ved ScaleAQ Stadion\"><section class=\"dk-card\"><p class=\"dk-label\">Ved kampstart</p><h2>Været på stadion</h2><p class=\"dk-weather-place\">ScaleAQ Stadion · Svortland</p><div id=\"dk-weather-result\" role=\"status\">Henter værvarsel …</div><p class=\"dk-weather-source\">Kilde: <a href=\"https://www.met.no/\" target=\"_blank\" rel=\"noopener noreferrer\">Meteorologisk institutt</a> · værprognose</p></section></aside><div class=\"dk-main\"><section class=\"dk-card dk-match\" aria-label=\"Kampdata\"><p class=\"dk-label\">Kampdata</p><div class=\"dk-teams\"><div class=\"dk-team\"><img id=\"dk-home-logo\" alt=\"\" hidden><span id=\"dk-home\">Henter kamp …</span></div><div class=\"dk-score\" id=\"dk-score\">–</div><div class=\"dk-team\"><img id=\"dk-away-logo\" alt=\"\" hidden><span id=\"dk-away\"></span></div></div><div id=\"dk-events-wrap\" class=\"dk-events-wrap\" hidden><h3>Kamphendelser</h3><div class=\"dk-events-head\"><strong id=\"dk-events-home\">Hjemmelag</strong><span>Min.</span><strong id=\"dk-events-away\">Bortelag</strong></div><ol class=\"dk-events\" id=\"dk-events\" aria-label=\"Kamphendelser, nyeste først\"></ol><p class=\"dk-events-empty\" id=\"dk-events-empty\" hidden>Ingen hendelser registrert ennå.</p></div><div class=\"dk-meta\" id=\"dk-meta\"><p>Henter kampinformasjon …</p></div></section>\n<div class=\"dk-grid\"><section class=\"dk-card\"><h2>Før kampen</h2><div class=\"dk-prose\" id=\"dk-intro\"><p>Henter bekreftet kampinformasjon …</p></div><p class=\"dk-source\" id=\"dk-source\"></p>\n<article class=\"dk-article-demo\" aria-label=\"Eksempel på kampartikkel\"><p class=\"dk-label\">Eksempelartikkel · kun for visning</p><h3>Bremnes foran neste oppgjør</h3><div class=\"dk-story\"><p class=\"dk-lead\">Kampdagen nærmer seg, og rammen er klar for et nytt oppgjør med Bremnes på banen.</p><p>For supporterne er dette en anledning til å samle seg om laget og følge utviklingen fra første spark på ballen. På denne testsiden viser vi hvordan en kampartikkel kan få plass ved siden av kampdata, avstemning og statistikk.</p><h4>Dette følger vi med på</h4><p>Hvem tar initiativet tidlig? Klarer Bremnes å finne rom mellom leddene, og hvem gjør forskjellen når kampen vipper? Her kan redaksjonen senere legge inn konkrete observasjoner, sitater og lenker når de er bekreftet.</p><p>Etter sluttsignalet kan artikkelen oppdateres med resultat, viktige hendelser og reaksjoner fra kampen. Inntil da er dette bare eksempeltekst for å vurdere utseendet på siden.</p></div><p class=\"dk-demo-note\">Demotekst for oppsettet. Dette er ikke en publisert kampomtale.</p></article>\n<div id=\"dk-article\" hidden><h3>Publisert kampartikkel</h3><p class=\"dk-muted\">Sjekker om en artikkel er publisert for denne kampen …</p></div></section>\n<section class=\"dk-card dk-vote dk-vote-before\"><h2>Stem på Dagens Bremnesing</h2><p class=\"dk-muted\" id=\"dk-vote-info\">Ny digital og interaktiv avstemning: Når kampen er i gang, kan du velge spilleren du mener fortjener tittelen Dagens Bremnesing.</p><p class=\"dk-vote-status\" id=\"dk-vote-status\" role=\"status\">Henter avstemningsstatus …</p><a class=\"dk-button\" id=\"dk-vote-link\" href=\"/dagenskamp/\" hidden>Gå til avstemningen</a></section></div>\n<section class=\"dk-card dk-sponsor\" id=\"dk-sponsor\" hidden><img id=\"dk-sponsor-logo\" alt=\"\" hidden><div><p class=\"dk-label\">Kampsponsor</p><h2 id=\"dk-sponsor-name\"></h2><p class=\"dk-muted\" id=\"dk-sponsor-thanks\"></p></div></section>\n</div>\n<aside class=\"dk-rail\" aria-label=\"Tabell og toppscorere\">\n<section class=\"dk-card\"><p class=\"dk-label\">Sesongen 2026</p><h3 class=\"dk-stat-title\">Tabell <span id=\"dk-league\">(henter divisjon …)</span></h3>\n<div class=\"dk-table-scroll\" role=\"region\" aria-label=\"Serietabell\" tabindex=\"0\"><table class=\"dk-stat-table\"><caption>Serietabell 2026</caption><thead><tr><th scope=\"col\">Pl.</th><th scope=\"col\">Lag</th><th scope=\"col\">K</th><th scope=\"col\">Mål</th><th scope=\"col\">P</th></tr></thead><tbody id=\"dk-table-body\"></tbody></table></div><div class=\"dk-stat-divider\" aria-hidden=\"true\"></div><h3 class=\"dk-stat-title\">Toppscorere</h3>\n<div class=\"dk-table-scroll\" role=\"region\" aria-label=\"Toppscorere\" tabindex=\"0\"><table class=\"dk-stat-table dk-scorers-table\"><caption>Toppscorere i serie og cup 2026</caption><thead><tr><th scope=\"col\">#</th><th scope=\"col\">Spiller</th><th scope=\"col\">Serie</th><th scope=\"col\">Cup</th><th scope=\"col\">Tot.</th></tr></thead><tbody id=\"dk-scorers-body\"></tbody></table></div><div class=\"dk-stat-source\"><p id=\"dk-scorers-note\"></p><a id=\"dk-scorers-link\" target=\"_blank\" rel=\"noopener noreferrer\" href=\"https://www.fotball.no/\">Kilde og oppdaterte tall: NFF / Fotball.no</a></div></section>\n</aside></div>\n<p class=\"dk-source\" id=\"dk-data-status\">Kampvisning: Radio Rubben. Tabell og målstatistikk: NFF, kontrollert 25.09.2026 før kampstart.</p>\n</div>\n<script>\n(function(){\n'use strict';\nvar root=document.getElementById('rr-dk-test'); if(!root)return;\nvar get=function(id){return root.querySelector('#'+id)};\nvar matchId=new URLSearchParams(location.search).get('dk_match');\nif(matchId&&!/^\\d{1,12}$/.test(matchId))matchId=null;\nvar source=new URL('/dagenskamp/',location.origin);if(matchId)source.searchParams.set('rr_match',matchId);\nvar set=function(id,value){get(id).textContent=value||''};\nvar safeImg=function(id,url,alt){try{var u=new URL(url,location.origin);if(!['https:','http:'].includes(u.protocol))return;var img=get(id);img.src=u.href;img.alt=alt||'';img.hidden=false}catch(e){}};\nvar last=null,weatherKickoff=null;\nasync function loadMatch(){\n try{\n  var response=await fetch(source.href,{credentials:'same-origin',cache:'no-store'});if(!response.ok)throw Error('Kampvisningen svarte ikke');\n  var doc=new DOMParser().parseFromString(await response.text(),'text/html'),card=doc.querySelector('main.rr-poll .poll-match');\n  if(!card)throw Error('Fant ikke kampdata');\n  var teams=card.querySelectorAll('.poll-team'),home=teams[0],away=teams[1];\n  if(!home||!away)throw Error('Fant ikke begge lag');\n  set('dk-home',home.querySelector('strong')?.textContent||'Hjemmelag');\n  set('dk-away',away.querySelector('strong')?.textContent||'Bortelag');\n  set('dk-events-home',get('dk-home').textContent);\n  set('dk-events-away',get('dk-away').textContent);\n  if(home.querySelector('img'))safeImg('dk-home-logo',home.querySelector('img').getAttribute('src'),home.querySelector('img').alt);\n  if(away.querySelector('img'))safeImg('dk-away-logo',away.querySelector('img').getAttribute('src'),away.querySelector('img').alt);\n  var details=card.querySelector('.poll-details');renderStats((details?.textContent||'').toLowerCase().includes('kvinner')?'women':(details?.textContent||'').toLowerCase().includes('menn')?'men':null);set('dk-meta',details?[...details.childNodes].map(function(n){return n.nodeType===1&&n.tagName==='BR'?' · ':n.textContent}).join('').trim():'Kampdetaljer ikke tilgjengelige');\n  var kickoff=details?.querySelector('time')?.getAttribute('datetime');weatherKickoff=kickoff;get('dk-weather').hidden=!kickoff||!/ScaleAQ Stadion/i.test(details?.textContent||'')||new Date(kickoff).getTime()<Date.now()-6*3600000;if(!get('dk-weather').hidden)loadWeather(kickoff);\n  var intro=doc.querySelector('main.rr-poll .poll-intro'),holder=get('dk-intro');holder.replaceChildren();\n  if(intro){intro.querySelectorAll('p').forEach(function(p){if(p.classList.contains('poll-intro-source'))return;var node=document.createElement('p');var head=p.querySelector('strong');var tail=head?p.textContent.slice(p.textContent.indexOf(head.textContent)+head.textContent.length).trim():'';if(head?.textContent.trim()==='Plassering på tabellen')tail=tail.replace(/^På tabellen:\\s*/, '');node.textContent=head?head.textContent.trim()+': '+tail:p.textContent.trim();holder.append(node)})}\n  if(!holder.childElementCount){var empty=document.createElement('p');empty.textContent='Ingen kampomtale er registrert ennå.';holder.append(empty)}\n  var sponsor=doc.querySelector('main.rr-poll .poll-partner');\n  if(sponsor){var name=sponsor.querySelector('.poll-partner-logo img')?.alt||sponsor.querySelector('.poll-partner-thanks')?.textContent||'';if(name){set('dk-sponsor-name',name);set('dk-sponsor-thanks',sponsor.querySelector('.poll-partner-thanks')?.textContent||'');var logo=sponsor.querySelector('img');if(logo)safeImg('dk-sponsor-logo',logo.getAttribute('src'),logo.alt);get('dk-sponsor').hidden=false}}\n  var matchLink=doc.querySelector('main.rr-poll a[href*=\"/fotballdata/kamp/\"][href*=\"fiksId=\"]'),parsed=matchLink?new URL(matchLink.href):null;\n  var current=parsed?.searchParams.get('fiksId');if(!matchId){if(current?.match(/^\\d+$/)){matchId=current;source.searchParams.set('rr_match',current)}}\n  get('dk-vote-link').href=source.href;\n  set('dk-source','Kilde: Radio Rubbens kampvisning'+(current?' · Kampnummer '+current:''));\n  if(matchId)loadArticle(matchId);\n  last=true;\n  await loadPoll();\n }catch(e){get('dk-meta').textContent='Kunne ikke hente kampinformasjon akkurat nå.';get('dk-intro').textContent='Prøv igjen senere, eller åpne den ordinære kampsiden.';get('dk-vote-status').textContent='Status utilgjengelig';root.querySelector('.dk-match').classList.add('dk-error')}\n}\nasync function loadArticle(id){\n var target=get('dk-article');try{\n  var articleUrl=new URL('/wp-json/wp/v2/posts',location.origin);articleUrl.searchParams.set('slug','rubben-kamp-'+id);articleUrl.searchParams.set('_fields','title,link,status');var r=await fetch(articleUrl.href,{cache:'no-store'});\n  if(!r.ok)throw Error('Artikkelsøk feilet');var posts=await r.json();\n  target.replaceChildren();target.hidden=!posts.length;\n  if(posts.length){var h=document.createElement('h3');h.textContent='Publisert kampartikkel';target.append(h);var a=document.createElement('a');a.href=posts[0].link;a.textContent=new DOMParser().parseFromString(posts[0].title.rendered,'text/html').body.textContent||'Les kampartikkelen';target.append(a)}\n  else{var p=document.createElement('p');p.className='dk-muted';p.textContent='Ingen kampartikkel er publisert for denne kampen ennå.';target.append(p)}\n }catch(e){target.querySelector('p')?.replaceChildren(document.createTextNode('Kunne ikke sjekke kampartikler nå.'))}\n}\nasync function loadWeather(kickoff){\n var holder=get('dk-weather-result'),start=new Date(kickoff).getTime(),now=Date.now();\n if(!Number.isFinite(start)){holder.textContent='Kampstart er ikke tilgjengelig.';return}\n if(start<now-6*3600000){holder.textContent='Værvarselet ved kampstart er ikke lenger tilgjengelig.';return}\n try{\n  var url=new URL('/wp-admin/admin-ajax.php',location.origin);url.searchParams.set('action','rr_weather');url.searchParams.set('lat','59.791');url.searchParams.set('lon','5.185');\n  var response=await fetch(url.href,{credentials:'same-origin'});if(!response.ok)throw Error('værdata');\n  var payload=await response.json();if(!payload.success||!Array.isArray(payload.data?.hours))throw Error('værdata');\n  var target=start<now-3600000?now:start;\n  var nearest=payload.data.hours.reduce(function(best,row){var delta=Math.abs(new Date(row.time).getTime()-target);return !best||delta<best.delta?{row:row,delta:delta}:best},null);\n  if(!nearest||nearest.delta>90*60000)throw Error('utenfor varselperioden');\n  var d=nearest.row,code=String(d.symbol||''),label='Skyet',icon='☁️';\n  if(/thunder/.test(code)){label='Tordenbyger';icon='⛈️'}\n  else if(/sleet/.test(code)){label='Sludd';icon='🌨️'}\n  else if(/snow/.test(code)){label='Snø';icon='❄️'}\n  else if(/rain/.test(code)){label='Regn';icon='🌧️'}\n  else if(/fog/.test(code)){label='Tåke';icon='🌫️'}\n  else if(/clearsky/.test(code)){label='Klart';icon='☀️'}\n  else if(/fair|partlycloudy/.test(code)){label='Delvis skyet';icon='⛅'}\n  holder.replaceChildren();\n  var time=document.createElement('p');time.className='dk-weather-time';time.textContent=(target===start?'Varsel ved kampstart: ':'Vær under kampen: ')+new Intl.DateTimeFormat('nb-NO',{timeZone:'Europe/Oslo',weekday:'short',day:'numeric',month:'short',hour:'2-digit',minute:'2-digit'}).format(new Date(d.time));\n  var main=document.createElement('div');main.className='dk-weather-main';var pict=document.createElement('span');pict.className='dk-weather-icon';pict.setAttribute('aria-hidden','true');pict.textContent=icon;var temp=document.createElement('strong');temp.className='dk-weather-temp';temp.textContent=Math.round(Number(d.temp))+'°';main.append(pict,temp);\n  var condition=document.createElement('p');condition.className='dk-weather-condition';condition.textContent=label;\n  var details=document.createElement('div');details.className='dk-weather-details';\n  [['Nedbør neste time',d.rain==null?'–':Number(d.rain).toLocaleString('nb-NO',{maximumFractionDigits:1})+' mm'],['Vind',d.wind==null?'–':Number(d.wind).toLocaleString('nb-NO',{maximumFractionDigits:1})+' m/s']].forEach(function(pair){var cell=document.createElement('div'),key=document.createElement('span'),value=document.createElement('strong');key.textContent=pair[0];value.textContent=pair[1];cell.append(key,value);details.append(cell)});\n  holder.append(time,main,condition,details);\n }catch(e){holder.textContent='Værvarselet er midlertidig utilgjengelig.'}\n}\nasync function loadPoll(){\n try{\n  var url=new URL(source.href);url.searchParams.set('rr_poll_api','1');\n  var response=await fetch(url.href,{credentials:'same-origin',cache:'no-store'});if(!response.ok)throw Error();\n  var d=await response.json();if(!d.ok)throw Error();\n  var started=!!(d.started||d.running||d.opened||d.finished||Number(d.period)>0);\n  var status=d.opened&&!d.closed?'Avstemningen er åpen':started&&(d.closed||d.finished)?'Avstemningen er avsluttet':started?'Kampen er i gang – avstemningen åpner snart':'Avstemningen åpner når kampen starter';\n  set('dk-vote-status',status);\n  get('dk-vote-link').hidden=!started;\n  root.querySelector('.dk-vote').classList.toggle('dk-vote-before',!started);\n  set('dk-vote-info',started?'Velg spilleren du mener fortjener utmerkelsen. Innlogging og stemmegivning skjer på den ordinære kampsiden.':'Ny digital og interaktiv avstemning: Når kampen er i gang, kan du velge spilleren du mener fortjener tittelen Dagens Bremnesing.');\n  if(started){if(d.score&&Number.isFinite(+d.score.home)&&Number.isFinite(+d.score.away))set('dk-score',d.score.home+'–'+d.score.away)}\n  var events=Array.isArray(d.match_events)?d.match_events:[];\n  var list=get('dk-events');list.replaceChildren();events.slice(0,12).forEach(function(ev){\n   var li=document.createElement('li');li.className='dk-event-item '+(ev.side==='away'?'away':'home');\n   var detail=document.createElement('span');detail.className='dk-event-team';\n   var icon=document.createElement('span');icon.className='dk-event-icon';icon.setAttribute('aria-hidden','true');icon.textContent=ev.type==='goal'?'⚽':ev.type==='sub'?'⇄':ev.type==='yellow'?'🟨':ev.type==='red'?'🟥':ev.type==='award'?'🏆':'';\n   var copy=document.createElement('span');copy.className='dk-event-copy';var title=document.createElement('strong');title.textContent=ev.label||'Hendelse';var description=document.createElement('span');description.textContent=ev.description||'';copy.append(title,description);detail.append(icon,copy);\n   var minute=document.createElement('strong');minute.className='dk-event-minute';minute.textContent=String(ev.minute||'')+(ev.minute?'′':'');\n   var left=document.createElement('span'),right=document.createElement('span');if(ev.side==='away')right.append(detail);else left.append(detail);\n   li.append(left,minute,right);list.append(li)});\n  get('dk-events-wrap').hidden=!(started||events.length);\n  get('dk-events-empty').hidden=!!events.length;\n }catch(e){set('dk-vote-status','Avstemningsstatus er midlertidig utilgjengelig')}\n}\n\nvar nffSnapshots={\n men:{\n  league:'5. div. menn avd. 03',\n  url:'https://www.fotball.no/fotballdata/lag/hjem/?fiksId=30365&underside=tabeller',\n  table:[\n   [1,'Smørås',17,'78–27',39],[2,'Ørnen',17,'65–26',38],[3,'Viggo',17,'62–32',37],\n   [4,'Bremnes',17,'63–37',35],[5,'Nore Neset',17,'39–34',24],[6,'Fitjar',17,'32–40',23],\n   [7,'Varegg 2',17,'42–45',22],[8,'Juristforeningen',17,'39–44',22],[9,'Flaktveit 2',17,'36–48',19],\n   [10,'Nymark 2',17,'40–68',18],[11,'Bønes',17,'26–55',12],[12,'Galgen',17,'18–84',3]\n  ],\n  scorers:[['Erlend Meling Nesse',24,0],['Pavlo Buriak',13,0],['Adrian Søvold',4,0],['Aron Skippervik Simonsen',3,0],['Niklas Rasmussen',3,0],['Sivert Tysse Fylkesnes',3,0]],\n  note:'Serie og NM-kvalifisering 2026/2027. Cupkampen hadde ingen registrerte Bremnes-mål.'\n },\n women:{\n  league:'3. div. kvinner Vestland',\n  url:'https://www.fotball.no/fotballdata/lag/hjem/?fiksId=48835&underside=tabeller',\n  table:[\n   [1,'Lyngbø',15,'56–14',37],[2,'Askøy',15,'34–12',32],[3,'Bjarg',16,'36–15',32],\n   [4,'Voss',16,'39–30',27],[5,'Arna-Bjørnar 2',15,'35–28',26],[6,'Åsane 2',15,'28–30',19],\n   [7,'Førde',16,'27–31',19],[8,'Stord',15,'30–38',17],[9,'Bremnes',15,'16–43',16],\n   [10,'Fyllingsdalen 2',16,'24–33',14],[11,'Os',16,'5–56',3]\n  ],\n  scorers:[['Julia Nesse',4,0],['Sanna Alena Oa Våge',4,0],['Kristin Stoknes',3,0],['Aurora Meling',2,0],['Emilie Ånderå',2,0],['Emmy Kallevåg Rinne',2,0],['Thea Eiken',2,0],['Tiril Berntsen Kvarven',2,0]],\n  note:'NFF oppgir kun seriekamper for Bremnes Kvinner 1 i 2026. Ingen cupturnering er oppført på lagsiden.'\n }\n};\nfunction renderStats(key){\n var data=nffSnapshots[key],rail=root.querySelector('.dk-rail');if(!data){rail.hidden=true;return}\n rail.hidden=false;set('dk-league','('+(key==='men'?'5. div herrer':'3. div kvinner')+')');\n var body=get('dk-table-body');body.replaceChildren();\n data.table.forEach(function(row){var tr=document.createElement('tr');if(row[1]==='Bremnes')tr.className='dk-highlight';row.forEach(function(value,index){var cell=document.createElement(index===1?'th':'td');if(index===1)cell.scope='row';cell.textContent=String(value);tr.append(cell)});body.append(tr)});\n var scorerBody=get('dk-scorers-body');scorerBody.replaceChildren();\n data.scorers.forEach(function(row,index){var tr=document.createElement('tr');[index+1,row[0],row[1],row[2],row[1]+row[2]].forEach(function(value,col){var cell=document.createElement(col===1?'th':'td');if(col===1)cell.scope='row';cell.textContent=String(value);tr.append(cell)});scorerBody.append(tr)});\n set('dk-scorers-note','Kontrollert 25.09.2026 før kampstart. '+data.note+' Tallene på denne siden oppdateres etter ny kontroll.');\n get('dk-scorers-link').href=data.url;\n}\nloadMatch();setInterval(function(){if(!last||document.hidden)return;loadPoll()},60000);setInterval(function(){if(document.hidden||!weatherKickoff||get('dk-weather').hidden)return;loadWeather(weatherKickoff)},900000);\n})();\n</script>\n<!-- /wp:html -->"
}

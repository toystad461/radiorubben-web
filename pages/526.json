  "post_content": "<!-- wp:html -->\n<section class=\"rr-legacy-player\">\n<style>\n    .rr-legacy-player{font-family:inherit;margin:0;background:var(--midnight,#0b0d11);color:var(--white,#f5f5f7)}\n    .rr-legacy-player .wrap{max-width:980px;margin:0 auto;padding:20px 0}\n    .rr-legacy-player .grid{display:grid;grid-template-columns:1fr;gap:14px}\n    @media(min-width:900px){.rr-legacy-player .grid{grid-template-columns:1.2fr .8fr}}\n    .rr-legacy-player .card{background:var(--panel,#15181f);border:1px solid var(--line,#2b303a);border-radius:var(--radius,10px);padding:16px;box-shadow:none}\n    .rr-legacy-player h1{margin:0 0 6px;font-size:22px}\n    .rr-legacy-player h2{margin:0 0 10px;font-size:16px;opacity:.9}\n    .rr-legacy-player .row{display:flex;gap:10px;align-items:center;flex-wrap:wrap}\n    .rr-legacy-player button{border:1px solid var(--line,#2b303a);background:var(--blue,#e43843);color:var(--white,#f5f5f7);border-radius:10px;padding:10px 12px;cursor:pointer}\n    .rr-legacy-player button:hover{background:#c72c37}\n    .rr-legacy-player .muted{opacity:.7}\n    .rr-legacy-player .pill{display:inline-block;border:1px solid var(--line,#2b303a);border-radius:999px;padding:4px 10px;font-size:12px;opacity:.9}\n    .rr-legacy-player img.cover{width:88px;height:88px;border-radius:12px;object-fit:cover;border:1px solid var(--line,#2b303a);background:var(--midnight,#0b0d11)}\n    .rr-legacy-player ul{margin:10px 0 0;padding:0;list-style:none}\n    .rr-legacy-player li{padding:10px 0;border-top:1px solid var(--line,#2b303a)}\n    .rr-legacy-player .err{color:#ffb3b3}\n    .rr-legacy-player code{background:var(--midnight,#0b0d11);border:1px solid var(--line,#2b303a);border-radius:8px;padding:2px 6px}\n  </style>\n\n  <div class=\"wrap\">\n    <h1>Radio Rubben – Testside</h1>\n    <div class=\"muted\">Spiller + “nå spiller” + historikk (Public API). Oppdateres automatisk.</div>\n    <div style=\"height:12px\"></div>\n\n    <div class=\"grid\">\n      <div class=\"card\">\n        <h2>Spiller</h2>\n        <div class=\"row\">\n          <button id=\"btnPlay\">▶️ Spill</button>\n          <button id=\"btnPause\">⏸️ Pause</button>\n          <span class=\"pill\" id=\"conn\">klar</span>\n        </div>\n\n        <div style=\"height:10px\"></div>\n        <audio id=\"player\" controls preload=\"none\" style=\"width:100%\"></audio>\n\n        <div style=\"height:14px\"></div>\n        <div class=\"row\">\n          <img class=\"cover\" id=\"cover\" alt=\"cover\" />\n          <div>\n            <div class=\"muted\" style=\"font-size:12px\">Nå spiller</div>\n            <div id=\"nowTitle\" style=\"font-size:18px;font-weight:650\">–</div>\n            <div id=\"nowArtist\" class=\"muted\">–</div>\n            <div style=\"height:6px\"></div>\n            <div class=\"row\">\n              <span class=\"pill\" id=\"onair\">status: –</span>\n              <span class=\"pill\" id=\"updated\">oppdatert: –</span>\n            </div>\n          </div>\n        </div>\n\n        <div style=\"height:12px\"></div>\n        <div class=\"row\">\n          <button id=\"btnRefresh\">🔄 Oppdater nå</button>\n          <span class=\"muted\">API: <code id=\"apiUrl\">–</code></span>\n        </div>\n\n        <div id=\"error\" class=\"err\" style=\"margin-top:10px\"></div>\n      </div>\n\n      <div class=\"card\">\n        <h2>Sist spilt</h2>\n        <ul id=\"history\"></ul>\n      </div>\n    </div>\n\n    <div style=\"height:16px\"></div>\n    <div class=\"card\">\n      <h2>Konfig (du kan endre her i fila)</h2>\n      <div class=\"muted\">\n        <div><b>Station ID</b>: <code id=\"stationOut\"></code></div>\n        <div><b>Stream URL</b>: <code id=\"streamOut\"></code></div>\n        <div style=\"height:8px\"></div>\n        Tips: Station ID er ofte “s….” (samme som i listen-URLen). Eksempel: <code>https://s2.radio.co/sXXXXXXXXXX/listen</code>\n      </div>\n    </div>\n  </div>\n\n<script>\n  // ======================\n  // 1) FYLL INN DISSE:\n  // ======================\n  const STATION_ID = \"s48df93692\"; // <-- bytt til din station id (s........)\n  const STREAM_URL = \"https://s2.radio.co/s48df93692/listen\"; // <-- bytt til din stream url\n\n  // ======================\n  // 2) Public API endpoints\n  // ======================\n  const STATUS_URL  = `https://public.radio.co/api/v2/${STATION_ID}/status`;\n  const HISTORY_URL = `https://public.radio.co/api/v2/${STATION_ID}/track/history`;\n\n  const el = (id) => document.getElementById(id);\n  const player = el(\"player\");\n  const conn = el(\"conn\");\n  const errorEl = el(\"error\");\n\n  el(\"stationOut\").textContent = STATION_ID;\n  el(\"streamOut\").textContent = STREAM_URL;\n  el(\"apiUrl\").textContent = STATUS_URL;\n\n  // Player setup\n  player.src = STREAM_URL;\n\n  el(\"btnPlay\").onclick = async () => {\n    errorEl.textContent = \"\";\n    conn.textContent = \"kobler…\";\n    try {\n      await player.play();\n      conn.textContent = \"spiller\";\n    } catch (e) {\n      conn.textContent = \"feil\";\n      errorEl.textContent = \"Kunne ikke starte avspilling. Sjekk stream-URL og nettleserens autoplay-regler.\";\n      console.error(e);\n    }\n  };\n\n  el(\"btnPause\").onclick = () => {\n    player.pause();\n    conn.textContent = \"pause\";\n  };\n\n  el(\"btnRefresh\").onclick = () => refreshAll();\n\n  function setNowPlaying({title, artist, artwork, onairText}) {\n    el(\"nowTitle\").textContent = title || \"–\";\n    el(\"nowArtist\").textContent = artist || \"–\";\n    el(\"onair\").textContent = `status: ${onairText || \"–\"}`;\n\n    const cover = el(\"cover\");\n    cover.src = artwork || \"data:image/svg+xml;charset=utf-8,\" + encodeURIComponent(\n      `<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"200\" height=\"200\">\n        <rect width=\"100%\" height=\"100%\" fill=\"#0b0f14\"/>\n        <text x=\"50%\" y=\"50%\" dominant-baseline=\"middle\" text-anchor=\"middle\"\n          fill=\"#7f8ea6\" font-family=\"system-ui\" font-size=\"14\">Radio Rubben</text>\n      </svg>`\n    );\n  }\n\n  function setHistory(items) {\n    const ul = el(\"history\");\n    ul.innerHTML = \"\";\n    if (!items || !items.length) {\n      ul.innerHTML = `<li class=\"muted\">Ingen historikk tilgjengelig akkurat nå.</li>`;\n      return;\n    }\n    for (const it of items.slice(0, 12)) {\n      const title = it?.title || it?.track?.title || \"–\";\n      const artist = it?.artist || it?.track?.artist || \"\";\n      const ts = it?.played_at || it?.time || it?.playedAt || \"\";\n      const li = document.createElement(\"li\");\n      li.innerHTML = `<div style=\"font-weight:650\">${escapeHtml(title)}</div>\n                      <div class=\"muted\">${escapeHtml(artist)} ${ts ? \"• \" + escapeHtml(ts) : \"\"}</div>`;\n      ul.appendChild(li);\n    }\n  }\n\n  function escapeHtml(s){ return String(s || \"\").replace(/[&<>\"']/g, m => ({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;',\"'\":'&#39;'}[m])); }\n\n  async function fetchJson(url) {\n    const res = await fetch(url, { cache: \"no-store\" });\n    if (!res.ok) throw new Error(`${res.status} ${res.statusText}`);\n    return await res.json();\n  }\n\n  async function refreshAll() {\n    errorEl.textContent = \"\";\n    try {\n      const [status, history] = await Promise.all([\n        fetchJson(STATUS_URL),\n        fetchJson(HISTORY_URL),\n      ]);\n\n      // Status-format kan variere litt – vi prøver flere vanlige felt\n      const np = status?.current_track || status?.currentTrack || status?.now_playing || status?.nowPlaying || {};\n      const title  = np?.title || np?.track?.title || status?.title || \"\";\n      const artist = np?.artist || np?.track?.artist || status?.artist || \"\";\n      const artwork = np?.artwork_url || np?.artwork || np?.track?.artwork_url || np?.track?.artwork || status?.artwork_url || \"\";\n      const onairText = status?.status || status?.state || (status?.live ? \"LIVE\" : \"AUTOMATIKK\");\n\n      setNowPlaying({ title, artist, artwork, onairText });\n\n      const items = history?.tracks || history?.data || history?.items || history;\n      setHistory(Array.isArray(items) ? items : []);\n\n      el(\"updated\").textContent = `oppdatert: ${new Date().toLocaleTimeString(\"no-NO\")}`;\n    } catch (e) {\n      console.error(e);\n      errorEl.textContent = \"Kunne ikke hente data fra Radio.co Public API. Sjekk Station ID og om CORS blokkerer i nettleser.\";\n    }\n  }\n\n  // Start\n  refreshAll();\n  setInterval(refreshAll, 15000);\n</script>\n</section>\n<!-- /wp:html -->\n\n<!-- wp:paragraph -->\n<p></p>\n<!-- /wp:paragraph -->"
}

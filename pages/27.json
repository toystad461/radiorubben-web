  "post_content": "<!-- wp:separator -->\n<hr class=\"wp-block-separator has-alpha-channel-opacity\"/>\n<!-- /wp:separator -->\n\n<!-- wp:paragraph -->\n<p><strong>Hør Radio Rubben live</strong><br>Kos deg med musikken, stemningen og sendingene våre – direkte fra Bømlo.<br>Trykk play og len deg tilbake.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:columns {\"verticalAlignment\":\"center\"} -->\n<div class=\"wp-block-columns are-vertically-aligned-center\"><!-- wp:column {\"verticalAlignment\":\"center\",\"width\":\"50%\"} -->\n<div class=\"wp-block-column is-vertically-aligned-center\" style=\"flex-basis:50%\"><!-- wp:html -->\n<script src=\"https://embed.radio.co/player/f0ee655.js\"></script>\n<!-- /wp:html -->\n\n<!-- wp:paragraph -->\n<p>Har du musikkønsker eller hilsener? Send melding til <a href=\"mailto:studio@radiorubben.no\">studio@radiorubben.no</a></p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:column -->\n\n<!-- wp:column {\"width\":\"50%\"} -->\n<div class=\"wp-block-column\" style=\"flex-basis:50%\"><!-- wp:html -->\n<script src=\"https://embed.radio.co/request/wf12bc00.js\"></script>\n<!-- /wp:html --></div>\n<!-- /wp:column --></div>\n<!-- /wp:columns -->\n\n<!-- wp:separator -->\n<hr class=\"wp-block-separator has-alpha-channel-opacity\"/>\n<!-- /wp:separator -->\n\n<!-- wp:html -->\n<script src=\"https://embed.radio.co/embeds/schedule/esf6473c0.js\"></script>\n<!-- /wp:html -->\n\n<!-- wp:separator -->\n<hr class=\"wp-block-separator has-alpha-channel-opacity\"/>\n<!-- /wp:separator -->\n\n<!-- wp:html {\"metadata\":{\"blockVisibility\":false}} -->\n<script src=\"https://embed.radio.co/request/wf12bc00.js\"></script>\n<!-- /wp:html -->"

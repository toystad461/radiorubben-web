  "post_content": "<!-- wp:columns {\"className\":\"rr-member-columns\"} -->\n<div class=\"wp-block-columns rr-member-columns\"><!-- wp:column {\"width\":\"60%\"} -->\n<div class=\"wp-block-column\" style=\"flex-basis:60%\"><!-- wp:group {\"className\":\"rr-vipps-entry\"} -->\n<div class=\"wp-block-group rr-vipps-entry\"><!-- wp:heading -->\n<h2 class=\"wp-block-heading\">Velkommen til Min Rubben</h2>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>Bruk Vipps for å komme i gang med leserkontoen din.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:shortcode -->\n[continue-with-vipps language=\"no\"]\n<!-- /wp:shortcode --></div>\n<!-- /wp:group -->\n\n<!-- wp:shortcode -->\n[min_rubben]\n<!-- /wp:shortcode --></div>\n<!-- /wp:column -->\n\n<!-- wp:column {\"width\":\"40%\"} -->\n<div class=\"wp-block-column\" style=\"flex-basis:40%\"><!-- wp:shortcode -->\n[rubben_duell]\n<!-- /wp:shortcode --></div>\n<!-- /wp:column --></div>\n<!-- /wp:columns -->\n\n<!-- wp:html -->\n<style>.page-id-736 .rr-page-content{max-width:none}.rr-vipps-entry{background:var(--panel,#15181f);border:1px solid var(--line,#2b303a);border-radius:10px;padding:24px;margin-bottom:24px}.logged-in .rr-vipps-entry{display:none}.rr-vipps-entry h2{font-size:26px;line-height:1.3}.rr-member-columns{align-items:flex-start;gap:28px}.rr-member-columns>.wp-block-column{min-width:0}.rr-member-columns .rrm{margin-top:0}.rr-member-columns .rrm h2{font-size:28px;line-height:1.25}.rr-member-columns #rrm-duel{scroll-margin-top:120px}@media(max-width:781px){.rr-member-columns{display:block}.rr-member-columns>.wp-block-column+ .wp-block-column{margin-top:28px}}</style>\n<script>\n(function(){\nfunction init(){\nvar root=document.querySelector('.rr-member-columns');if(!root)return;\nvar kind=new URLSearchParams(location.search).get('rrm_kind');\nif(kind!=='wish'&&kind!=='greeting')return;\nvar target=root.querySelector('.rrm');if(!target)return;target.id='rrm-send';\nvar select=target.querySelector('select[name=\"kind\"]');if(select){select.value=kind;select.dispatchEvent(new Event('change',{bubbles:true}));}\ntarget.querySelectorAll('a[href]').forEach(function(a){var u=new URL(a.href,location.href);if(u.origin===location.origin&&u.pathname.endsWith('/wp-login.php')){var back=new URL('/min-side/',location.origin);back.searchParams.set('rrm_kind',kind);back.hash='rrm-send';u.searchParams.set('redirect_to',back.href);a.href=u.href;}});\nvar entry=!document.body.classList.contains('logged-in')&&root.querySelector('.rr-vipps-entry');var scrollTarget=entry||target;scrollTarget.style.scrollMarginTop='120px';scrollTarget.scrollIntoView({block:'start',behavior:'instant'});\n}\nif(document.readyState==='loading')document.addEventListener('DOMContentLoaded',init);else init();\n})();\n</script>\n<!-- /wp:html -->"

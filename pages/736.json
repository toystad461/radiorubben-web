  "post_content": "<!-- wp:html -->\n<section class=\"rr-quiz-challenge\" aria-labelledby=\"rr-quiz-challenge-title\">\n  <div class=\"rr-quiz-challenge-copy\">\n    <p class=\"rr-eyebrow\">UKENS RUBBEN-QUIZ</p>\n    <h2 id=\"rr-quiz-challenge-title\">Utfordre en venn eller kollega</h2>\n    <p>Hvem får flest riktige? Send utfordringen videre og se hvem som klatrer på topplisten.</p>\n  </div>\n  <div class=\"rr-quiz-challenge-actions\">\n    <button type=\"button\" class=\"rr-quiz-challenge-share\">Del utfordringen</button>\n    <button type=\"button\" class=\"rr-quiz-challenge-copy-button\">Kopier utfordring</button>\n    <a href=\"/quiz/#rr-weekly\">Ta quizen selv →</a>\n  </div>\n  <p class=\"rr-quiz-challenge-feedback\" role=\"status\" aria-live=\"polite\"></p>\n  <input class=\"rr-quiz-challenge-manual\" aria-label=\"Kopier utfordringen manuelt\" readonly hidden>\n</section>\n<style>\n.page-id-736 .rr-quiz-challenge{display:flex;flex-wrap:wrap;align-items:center;gap:12px 28px;padding:22px 26px;margin:0 0 28px;border:1px solid #843039;border-radius:12px;background:linear-gradient(110deg,#24171c,#15181f);color:#f5f5f7}\n.page-id-736 .rr-quiz-challenge-copy{flex:1 1 290px}\n.page-id-736 .rr-quiz-challenge .rr-eyebrow{margin:0 0 5px;color:#ff858e}\n.page-id-736 .rr-quiz-challenge h2{margin:0 0 7px;font-size:clamp(1.35rem,2vw,1.65rem);line-height:1.25}\n.page-id-736 .rr-quiz-challenge-copy>p:last-child{margin:0;color:#d5d7df}\n.page-id-736 .rr-quiz-challenge-actions{display:flex;flex-wrap:wrap;align-items:center;gap:10px;flex:0 1 430px}\n.page-id-736 .rr-quiz-challenge-actions button{min-height:44px;padding:10px 15px;border-radius:7px;font:inherit;font-weight:700;cursor:pointer}\n.page-id-736 .rr-quiz-challenge-share{background:#e43843;color:white;border:1px solid #e43843}\n.page-id-736 .rr-quiz-challenge-copy-button{background:transparent;color:white;border:1px solid #b7bac3}\n.page-id-736 .rr-quiz-challenge-actions a{color:white;text-underline-offset:3px;font-weight:700}\n.page-id-736 .rr-quiz-challenge-actions :is(button,a):focus-visible{outline:3px solid #fff;outline-offset:3px}\n.page-id-736 .rr-quiz-challenge-feedback{flex-basis:100%;margin:0;color:#fff}\n.page-id-736 .rr-quiz-challenge-feedback:empty{display:none}\n.page-id-736 .rr-quiz-challenge-manual:not([hidden]){flex-basis:100%;width:100%;min-height:44px;padding:8px;border-radius:6px;border:1px solid #b7bac3;background:#fff;color:#111}\n@media(max-width:650px){.page-id-736 .rr-quiz-challenge{padding:18px}.page-id-736 .rr-quiz-challenge-actions{flex-basis:100%}.page-id-736 .rr-quiz-challenge-actions button{flex:1 1 100%}}\n</style>\n<script>\n(function(){\n  var card=document.querySelector('.rr-quiz-challenge');if(!card)return;\n  var url='https://www.radiorubben.no/quiz/#rr-weekly';\n  var message='Jeg utfordrer deg til Ukens Rubben-quiz! Hvem får flest riktige?';\n  var feedback=card.querySelector('.rr-quiz-challenge-feedback');\n  function manual(){\n    var input=card.querySelector('.rr-quiz-challenge-manual');\n    input.value=message+' '+url;input.hidden=false;input.select();\n    feedback.textContent='Velg og kopier teksten i feltet.';\n  }\n  async function copy(){\n    try{\n      if(!navigator.clipboard||!navigator.clipboard.writeText)throw new Error('Clipboard unavailable');\n      await navigator.clipboard.writeText(message+' '+url);\n      feedback.textContent='Utfordringen er kopiert. Send den til en venn eller kollega!';\n    }catch(e){manual();}\n  }\n  card.querySelector('.rr-quiz-challenge-copy-button').addEventListener('click',copy);\n  card.querySelector('.rr-quiz-challenge-share').addEventListener('click',async function(){\n    if(navigator.share){\n      try{await navigator.share({title:'Ukens Rubben-quiz',text:message,url:url});return;}\n      catch(e){if(e.name==='AbortError')return;}\n    }\n    await copy();\n  });\n})();\n</script>\n<!-- /wp:html -->\n\n<!-- wp:columns {\"className\":\"rr-member-columns\"} -->\n<div class=\"wp-block-columns rr-member-columns\"><!-- wp:column {\"width\":\"60%\"} -->\n<div class=\"wp-block-column\" style=\"flex-basis:60%\"><!-- wp:group {\"className\":\"rr-vipps-entry\"} -->\n<div class=\"wp-block-group rr-vipps-entry\"><!-- wp:heading -->\n<h2 class=\"wp-block-heading\">Velkommen til Min Rubben</h2>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>Bruk Vipps for å komme i gang med leserkontoen din.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:shortcode -->\n[continue-with-vipps language=\"no\"]\n<!-- /wp:shortcode -->\n<!-- wp:paragraph {\"className\":\"rr-login-legal\"} -->\n<p class=\"rr-login-legal\">Les våre <a href=\"/vilkar/\">bruksvilkår</a> og vår <a href=\"/personvern/\">personvernerklæring</a> når du logger inn med Vipps.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:shortcode -->\n[min_rubben]\n<!-- /wp:shortcode --></div>\n<!-- /wp:column -->\n\n<!-- wp:column {\"width\":\"40%\"} -->\n<div class=\"wp-block-column\" style=\"flex-basis:40%\"><!-- wp:shortcode -->\n[rubben_duell]\n<!-- /wp:shortcode --></div>\n<!-- /wp:column --></div>\n<!-- /wp:columns -->\n\n<!-- wp:html -->\n<style>.page-id-736 .rr-page-content{max-width:none}.rr-vipps-entry{background:var(--panel,#15181f);border:1px solid var(--line,#2b303a);border-radius:10px;padding:24px;margin-bottom:24px}.logged-in .rr-vipps-entry{display:none}.rr-vipps-entry h2{font-size:26px;line-height:1.3}.rr-member-columns{align-items:flex-start;gap:28px}.rr-member-columns>.wp-block-column{min-width:0}.rr-member-columns .rrm{margin-top:0}.rr-member-columns .rrm h2{font-size:28px;line-height:1.25}.rr-member-columns #rrm-duel{scroll-margin-top:120px}@media(max-width:781px){.rr-member-columns{display:block}.rr-member-columns>.wp-block-column+ .wp-block-column{margin-top:28px}}</style>\n<script>\n(function(){\nfunction init(){\nvar root=document.querySelector('.rr-member-columns');if(!root)return;\nvar kind=new URLSearchParams(location.search).get('rrm_kind');\nif(kind!=='wish'&&kind!=='greeting')return;\nvar target=root.querySelector('.rrm');if(!target)return;target.id='rrm-send';\nvar select=target.querySelector('select[name=\"kind\"]');if(select){select.value=kind;select.dispatchEvent(new Event('change',{bubbles:true}));}\ntarget.querySelectorAll('a[href]').forEach(function(a){var u=new URL(a.href,location.href);if(u.origin===location.origin&&u.pathname.endsWith('/wp-login.php')){var back=new URL('/min-side/',location.origin);back.searchParams.set('rrm_kind',kind);back.hash='rrm-send';u.searchParams.set('redirect_to',back.href);a.href=u.href;}});\nvar entry=!document.body.classList.contains('logged-in')&&root.querySelector('.rr-vipps-entry');var scrollTarget=entry||target;scrollTarget.style.scrollMarginTop='120px';scrollTarget.scrollIntoView({block:'start',behavior:'instant'});\n}\nif(document.readyState==='loading')document.addEventListener('DOMContentLoaded',init);else init();\n})();\n</script>\n<!-- /wp:html -->"
}

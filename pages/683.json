  "post_content": "<!-- wp:html -->\n<section class=\"rr-page rr-samarbeid\">\n  <style>\n/* Samarbeidsinnhold følger Radio Rubben One. Kun denne seksjonen. */\n.rr-samarbeid{background:var(--midnight,#0b0d11);color:var(--white,#f5f5f7);font-family:inherit;line-height:1.6;overflow:hidden}\n.rr-samarbeid *{box-sizing:border-box}\n.rr-samarbeid .rr-wrap{width:100%;max-width:1180px;margin:0 auto;padding:0}\n.rr-samarbeid .rr-section{padding:40px 0}\n.rr-samarbeid .rr-section:first-of-type{padding-top:12px}\n.rr-samarbeid .rr-section.alt{background:transparent;border-top:1px solid var(--line,#2b303a);border-bottom:0}\n.rr-samarbeid .rr-label{color:var(--signal,#ff555e);font-size:.75rem;font-weight:800;letter-spacing:.12em;text-transform:uppercase;margin-bottom:12px}\n.rr-samarbeid .rr-title{color:var(--white,#f5f5f7);font-size:clamp(1.65rem,3.5vw,2.7rem);line-height:1.12;letter-spacing:-.035em;font-weight:800;margin:0 0 18px}\n.rr-samarbeid .rr-text{color:var(--slate,#afb5c0);font-size:1rem;line-height:1.75;max-width:760px;margin:0 0 28px}\n.rr-samarbeid .rr-grid{display:grid;gap:16px}\n.rr-samarbeid .rr-grid-4{grid-template-columns:repeat(4,minmax(0,1fr))}\n.rr-samarbeid .rr-grid-3{grid-template-columns:repeat(3,minmax(0,1fr))}\n.rr-samarbeid .rr-card,.rr-samarbeid .rr-value,.rr-samarbeid .rr-contact-box{background:var(--panel,#15181f);border:1px solid var(--line,#2b303a);border-radius:var(--radius,10px);padding:24px;box-shadow:none;min-width:0}\n.rr-samarbeid .rr-card{min-height:0;transition:border-color .2s}\n.rr-samarbeid .rr-card:hover{border-color:var(--blue,#e43843)}\n.rr-samarbeid .rr-icon{width:42px;height:42px;display:grid;place-items:center;border-radius:8px;background:rgba(228,56,67,.1);color:var(--signal,#ff555e);font-size:1.3rem;margin-bottom:16px}\n.rr-samarbeid .rr-card h3,.rr-samarbeid .rr-value h3,.rr-samarbeid .rr-contact-box h3{color:var(--white,#f5f5f7);font-size:1.1rem;font-weight:750;line-height:1.35;margin:0 0 10px}\n.rr-samarbeid .rr-card p,.rr-samarbeid .rr-value p,.rr-samarbeid .rr-contact-box p{color:var(--slate,#afb5c0);font-size:1rem;line-height:1.7;margin:0}\n.rr-samarbeid .rr-list{display:grid;gap:12px;margin:24px 0 0;padding:0;list-style:none;max-width:760px}\n.rr-samarbeid .rr-list li{padding:16px 20px;border-radius:var(--radius,10px);background:var(--panel,#15181f);border:1px solid var(--line,#2b303a);color:var(--slate,#afb5c0)}\n.rr-samarbeid .rr-list strong{color:var(--white,#f5f5f7)}\n.rr-samarbeid .rr-values{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:16px;margin-top:28px}\n.rr-samarbeid .rr-letter{color:var(--signal,#ff555e);font-size:2.4rem;font-weight:900;line-height:1;margin-bottom:14px}\n.rr-samarbeid .rr-cta{padding:36px;border-radius:var(--radius,10px);background:var(--panel,#15181f);border:1px solid var(--line,#2b303a);box-shadow:none;color:var(--white,#f5f5f7)}\n.rr-samarbeid .rr-cta h2{font-size:clamp(1.65rem,3.5vw,2.7rem);line-height:1.12;letter-spacing:-.035em;font-weight:800;margin:0 0 16px}\n.rr-samarbeid .rr-cta p{max-width:720px;font-size:1rem;line-height:1.75;color:var(--slate,#afb5c0);margin:0 0 24px}\n.rr-samarbeid .rr-btn{display:inline-flex;align-items:center;justify-content:center;min-height:48px;max-width:100%;padding:13px 22px;border:1px solid transparent;border-radius:8px;background:var(--blue,#e43843);color:#fff;font-size:1rem;font-weight:750;line-height:1.4;text-align:center;text-decoration:none;box-shadow:none;white-space:normal}\n.rr-samarbeid .rr-btn:hover{background:#c72c37;color:#fff}\n.rr-samarbeid a:focus-visible{outline:2px solid var(--white,#f5f5f7);outline-offset:4px}\n.rr-samarbeid .rr-contact{display:grid;grid-template-columns:1.2fr .8fr;gap:16px}\n.rr-samarbeid .rr-contact-box a{color:var(--signal,#ff555e);text-decoration:underline;text-underline-offset:3px;overflow-wrap:anywhere}\n@media(max-width:960px){.rr-samarbeid .rr-grid-4,.rr-samarbeid .rr-grid-3,.rr-samarbeid .rr-values{grid-template-columns:repeat(2,minmax(0,1fr))}}\n@media(max-width:640px){.rr-samarbeid .rr-section{padding:32px 0}.rr-samarbeid .rr-grid-4,.rr-samarbeid .rr-grid-3,.rr-samarbeid .rr-values,.rr-samarbeid .rr-contact{grid-template-columns:1fr}.rr-samarbeid .rr-card,.rr-samarbeid .rr-value,.rr-samarbeid .rr-contact-box,.rr-samarbeid .rr-cta{padding:22px}.rr-samarbeid .rr-btn{width:100%}}\n</style>\n\n  \n\n  <section class=\"rr-section\">\n    <div class=\"rr-wrap\">\n      <div class=\"rr-label\">Hvorfor Radio Rubben?</div>\n      <h2 class=\"rr-title\">Lokal synlighet med ekte nærhet.</h2>\n      <p class=\"rr-text\">\n        Radio Rubben er en moderne lokalradio fra Bømlo. Vi kombinerer lyd, nettside,\n        sosiale medier og lokal tilstedeværelse for å skape synlighet som føles nær,\n        relevant og troverdig.\n      </p>\n\n      <div class=\"rr-grid rr-grid-4\">\n        <article class=\"rr-card\">\n          <div class=\"rr-icon\">📍</div>\n          <h3>Lokal synlighet</h3>\n          <p>Vi når mennesker på Bømlo og i Vestland gjennom radio, nettside og sosiale medier.</p>\n        </article>\n\n        <article class=\"rr-card\">\n          <div class=\"rr-icon\">🎧</div>\n          <h3>Moderne lokalradio</h3>\n          <p>Vi bygger en digital radiokanal med musikk, innhold, historier og levende lokal profil.</p>\n        </article>\n\n        <article class=\"rr-card\">\n          <div class=\"rr-icon\">🧡</div>\n          <h3>Ekte nærhet</h3>\n          <p>Lokalradio skaper en personlig tilknytning store nasjonale medier ikke kan tilby.</p>\n        </article>\n\n        <article class=\"rr-card\">\n          <div class=\"rr-icon\">⚙️</div>\n          <h3>Fleksible løsninger</h3>\n          <p>Vi kan tilpasse samarbeid og synlighet til både små og store lokale aktører.</p>\n        </article>\n      </div>\n    </div>\n  </section>\n\n  <section id=\"muligheter\" class=\"rr-section alt\">\n    <div class=\"rr-wrap\">\n      <div class=\"rr-label\">Muligheter</div>\n      <h2 class=\"rr-title\">Hva vi kan tilby.</h2>\n      <p class=\"rr-text\">\n        Samarbeid med Radio Rubben kan bygges enkelt eller mer omfattende.\n        Målet er alltid at samarbeidet skal være tydelig, lokalt og verdifullt.\n      </p>\n\n      <div class=\"rr-grid rr-grid-3\">\n        <article class=\"rr-card\">\n          <div class=\"rr-icon\">📻</div>\n          <h3>Sponsorplakater</h3>\n          <p>Korte sponsorinnslag på radio med lokal og profesjonell profil.</p>\n        </article>\n\n        <article class=\"rr-card\">\n          <div class=\"rr-icon\">🔴</div>\n          <h3>LIVE-sponsorater</h3>\n          <p>Synlighet rundt sendinger, programmer, kampanjer og spesielle satsinger.</p>\n        </article>\n\n        <article class=\"rr-card\">\n          <div class=\"rr-icon\">🌐</div>\n          <h3>Nettsideprofilering</h3>\n          <p>Logo, lenker, artikler eller profilerende innhold på radiorubben.no.</p>\n        </article>\n\n        <article class=\"rr-card\">\n          <div class=\"rr-icon\">📱</div>\n          <h3>Sosiale medier</h3>\n          <p>Lokale kampanjer, innlegg og synlighet på Facebook og Instagram.</p>\n        </article>\n\n        <article class=\"rr-card\">\n          <div class=\"rr-icon\">🎤</div>\n          <h3>Arrangement</h3>\n          <p>Samarbeid rundt lokale arrangementer, aktiviteter, kamper og møteplasser.</p>\n        </article>\n\n        <article class=\"rr-card\">\n          <div class=\"rr-icon\">🎙️</div>\n          <h3>Produksjon</h3>\n          <p>Produksjon av lyd, jingler, reklame og enkle kampanjepakker.</p>\n        </article>\n      </div>\n    </div>\n  </section>\n\n  <section class=\"rr-section\">\n    <div class=\"rr-wrap\">\n      <div class=\"rr-label\">Hvem passer det for?</div>\n      <h2 class=\"rr-title\">For lokale bedrifter som vil bli hørt.</h2>\n      <p class=\"rr-text\">\n        Radio Rubben passer for bedrifter og organisasjoner som ønsker en mer personlig\n        og lokal kanal ut til folk. Samarbeidet kan tilpasses etter mål, budsjett og behov.\n      </p>\n\n      <ul class=\"rr-list\">\n        <li><strong>Lokal synlighet:</strong> nå ut til folk i nærområdet på en naturlig måte.</li>\n        <li><strong>Ekte engasjement:</strong> bli en del av innhold som faktisk betyr noe lokalt.</li>\n        <li><strong>Moderne markedsføring:</strong> kombiner radio, nettside og sosiale medier.</li>\n        <li><strong>Nærhet til lokalsamfunnet:</strong> støtt en lokal kanal med tydelig identitet.</li>\n      </ul>\n    </div>\n  </section>\n\n  <section class=\"rr-section alt\">\n    <div class=\"rr-wrap\">\n      <div class=\"rr-label\">Identitet</div>\n      <h2 class=\"rr-title\">Bygget på LIVE-verdiene.</h2>\n\n      <div class=\"rr-values\">\n        <div class=\"rr-value\">\n          <div class=\"rr-letter\">L</div>\n          <h3>Lokal</h3>\n          <p>Vi sender fra Bømlo og kjenner stedet.</p>\n        </div>\n\n        <div class=\"rr-value\">\n          <div class=\"rr-letter\">I</div>\n          <h3>Inkluderende</h3>\n          <p>Alle skal føle seg velkommen hos Radio Rubben.</p>\n        </div>\n\n        <div class=\"rr-value\">\n          <div class=\"rr-letter\">V</div>\n          <h3>Verdig</h3>\n          <p>Vi møter mennesker og historier med respekt.</p>\n        </div>\n\n        <div class=\"rr-value\">\n          <div class=\"rr-letter\">E</div>\n          <h3>Engasjerende</h3>\n          <p>Vi lager radio folk faktisk ønsker å høre på.</p>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <section class=\"rr-section\">\n    <div class=\"rr-wrap\">\n      <div class=\"rr-cta\">\n        <h2>La oss skape noe sammen.</h2>\n        <p>\n          Vi tar gjerne en uforpliktende prat om hvordan Radio Rubben kan bidra med\n          lokal synlighet, god lydprofil og ekte engasjement for din bedrift eller organisasjon.\n        </p>\n        <a class=\"rr-btn\" href=\"mailto:post@radiorubben.no\">📧 Send en henvendelse</a>\n      </div>\n    </div>\n  </section>\n\n  <section class=\"rr-section alt\">\n    <div class=\"rr-wrap\">\n      <div class=\"rr-contact\">\n        <div class=\"rr-contact-box\">\n          <h3>Kontakt Radio Rubben</h3>\n          <p>\n            Har du spørsmål om samarbeid, sponsorat eller synlighet?\n            Send oss en kort melding, så tar vi praten videre.\n          </p>\n          <p><a href=\"mailto:post@radiorubben.no\">post@radiorubben.no</a></p>\n        </div>\n\n        <div class=\"rr-contact-box\">\n          <h3>Radio Rubben AS</h3>\n          <p>\n            Org.nr. 835598482<br>\n            Bømlo, Vestland<br>\n            Lokalradio med ekte engasjement.\n          </p>\n        </div>\n      </div>\n    </div>\n  </section>\n</section>\n<!-- /wp:html -->"
}
